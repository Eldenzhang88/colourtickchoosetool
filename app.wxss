page{background:#f3f7f8;color:#173c4a;font-size:28rpx;font-family:system-ui,-apple-system,sans-serif}view,text,button,input{box-sizing:border-box}.page{padding:28rpx 28rpx 70rpx}.hero{padding:22rpx 0}.eyebrow{color:#087f83;font-size:24rpx;letter-spacing:3rpx}.title{font-size:44rpx;font-weight:700;margin:12rpx 0}.subtitle,.muted{color:#657d86;font-size:25rpx;line-height:1.8}.card{background:#fff;border:1rpx solid #e2ecee;border-radius:24rpx;padding:28rpx;margin:22rpx 0;box-shadow:0 6rpx 22rpx #123b4a05}.section{font-size:31rpx;font-weight:650;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.wrap{display:flex;flex-wrap:wrap;gap:14rpx}.primary{background:#087f83!important;color:white!important}.secondary{background:#e6f3f2!important;color:#087f83!important}button{border-radius:16rpx;font-size:28rpx;margin:16rpx 0;line-height:2.8}button::after{border:0}.small{font-size:24rpx;padding:0 24rpx;margin:8rpx 0}.danger{color:#ae422a}.warning{background:#fff3df;border-radius:16rpx;color:#875614;padding:20rpx;line-height:1.8;font-size:25rpx}.field{margin:22rpx 0}.label{font-size:25rpx;color:#526f7a;margin-bottom:12rpx}input,picker{background:#f1f6f7;border-radius:12rpx;padding:20rpx;height:84rpx}switch{transform:scale(.85);transform-origin:right center}.ball{width:76rpx;height:76rpx;border-radius:50%;background:#edf3f5;color:#496772;display:flex;align-items:center;justify-content:center;font-size:29rpx;font-weight:650;border:2rpx solid transparent}.ball.selected{background:#087f83;color:white;border-color:#075d62}.balls{display:flex;flex-wrap:wrap;gap:16rpx;margin:22rpx 0}.big{font-size:48rpx;font-weight:700}.progress{height:18rpx;border-radius:20rpx;background:#e5eff0;overflow:hidden;margin:20rpx 0}.fill{height:100%;background:#13a29b;border-radius:20rpx}.record{padding:22rpx 0;border-bottom:1rpx solid #edf2f3}.record:last-child{border-bottom:0}.divider{height:1rpx;background:#e3ecee;margin:24rpx 0}.tag{font-size:22rpx;padding:6rpx 14rpx;background:#e8f3f1;color:#087f83;border-radius:8rpx}.code{font-family:monospace;word-break:break-all;font-size:23rpx;line-height:1.8}.empty{color:#84969e;text-align:center;padding:28rpx 0}.pair{display:flex;align-items:center;gap:16rpx}.pair input{flex:1;min-width:0}.link{color:#087f83}.footer{font-size:23rpx;line-height:1.8;color:#71858d;margin:28rpx 0}

disclaimer-bar{display:block;position:sticky;top:0;z-index:20}
