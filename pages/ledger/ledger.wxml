<disclaimer-bar/><view class="page"><view class="hero"><view class="title">预算账本</view><view class="subtitle">手动记录实际支出 · 不关联购票交易</view></view><view class="card"><view class="row"><view class="section">{{summary.month}} 月度汇总</view><text wx:if="{{summary.over}}" class="danger">已超预算</text></view><view class="big">¥{{summary.spent}}</view><view class="progress"><view class="fill" style="width:{{summary.percent}}%"></view></view><view class="muted">月预算 ¥{{summary.budget.monthly}} · 剩余 ¥{{summary.remaining}}<br/>单期累计上限 ¥{{summary.budget.perIssue}}</view></view><view class="card"><view class="section">记一笔</view><view class="field"><view class="label">金额（元）</view><input type="digit" value="{{amount}}" data-key="amount" bindinput="input" placeholder="例如 20.00"/></view><view class="field"><view class="label">期号（同一期请使用相同期号）</view><input value="{{issue}}" data-key="issue" bindinput="input" maxlength="32" placeholder="例如 2026123"/></view><view class="field"><view class="label">玩法</view><picker range="{{plays}}" value="{{playIndex}}" bindchange="play">快乐8 · {{plays[playIndex]}}</picker></view><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="add">保存支出记录</button></view><view class="card"><view class="section">全部记录 · {{records.length}} 笔</view><view wx:if="{{!records.length}}" class="empty">暂无记录</view><view wx:for="{{records}}" wx:key="id" class="record"><view class="row"><text>{{item.play}} · {{item.issue}}</text><text>¥{{item.amount}}</text></view><view class="muted">{{item.time}}</view><view wx:if="{{item.over}}" class="danger">超限后确认记录</view><button class="small secondary" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view>
